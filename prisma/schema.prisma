generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  documents Document[] @relation("OwnedDocuments")
  shares    Share[]
  edits     Document[] @relation("LastEditedBy")
  presences Presence[]
}

model Document {
  id             String   @id @default(cuid())
  title          String
  contentHtml    String   @default("<p></p>") @db.Text
  ownerId        String
  owner          User     @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  lastEditedById String?
  lastEditedBy   User?    @relation("LastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shares    Share[]
  presences Presence[]

  @@index([ownerId])
}

/// Ephemeral "who has this document open right now" heartbeat, polled by clients.
model Presence {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @updatedAt

  @@unique([documentId, userId])
  @@index([documentId])
}

enum Role {
  VIEW
  EDIT
}

model Share {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @default(VIEW)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId])
}
